# -*- coding: utf-8 -*-
"""NEXUS Desktop UI v1 — tkinter (stdlib) — MIDPOINT gates #6/#7/#8.

Three REAL selftest modes (no fakery — a windowless session is an honest
FAIL with the exact error):

  ui_selftest       gate #6  — the first real chat window: sidebar with
                    REAL conversations/tasks (from the task repository),
                    chat area, composer, activity feed, status bar; one
                    real model attempt through the launcher runtime
                    ladder; a REAL screen capture as the visual proof.
  tray_selftest     gate #7  — a REAL tray icon via Shell_NotifyIconW
                    (NIM_ADD → NIM_MODIFY → pump → NIM_DELETE) + a real
                    popup menu built via CreatePopupMenu/AppendMenuW.
  overlay_selftest  gate #8  — a REAL always-on-top translucent overlay
                    ("NEXUS is working" + Pause/Resume) that toggles its
                    own state, over the real desktop.

Screenshot: stdlib ctypes GDI (BitBlt → GetDIBits → zlib PNG) — no
third-party dependency, no shell, no unknown tool API.
"""

from __future__ import annotations

import ctypes
import json
import os
import struct
import sys
import time
import zlib
from ctypes import wintypes
from pathlib import Path

user32 = ctypes.windll.user32
gdi32 = ctypes.windll.gdi32
shell32 = ctypes.windll.shell32

SRCCOPY = 0x00CC0020
PM_REMOVE = 1
NIM_ADD, NIM_MODIFY, NIM_DELETE = 0, 1, 2
NIF_MESSAGE, NIF_ICON, NIF_TIP = 0x1, 0x2, 0x4
WM_APP_TRAY = 0x8000 + 1
MF_STRING = 0x0


# ------------------------------------------------------------------ PNG


def _png_chunk(tag: bytes, data: bytes) -> bytes:
    c = struct.pack(">I", len(data)) + tag + data
    return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)


def grab_screen_png(path: Path) -> dict:
    """Real full-screen capture → PNG (stdlib GDI). Honest result dict."""
    info: dict = {"method": "ctypes GDI BitBlt → GetDIBits → zlib PNG",
                  "path": str(path)}
    try:
        try:
            user32.SetProcessDPIAware()
        except BaseException:  # noqa: BLE001
            pass
        w = user32.GetSystemMetrics(0)
        h = user32.GetSystemMetrics(1)
        info["width"], info["height"] = w, h
        if w <= 0 or h <= 0:
            info["error"] = f"GetSystemMetrics gave {w}x{h} (no desktop?)"
            return info
        hdc = user32.GetDC(0)
        mem = gdi32.CreateCompatibleDC(hdc)
        bmp = gdi32.CreateCompatibleBitmap(hdc, w, h)
        gdi32.SelectObject(mem, bmp)
        gdi32.BitBlt(mem, 0, 0, w, h, hdc, 0, 0, SRCCOPY)

        class BMIH(ctypes.Structure):
            _fields_ = [
                ("biSize", wintypes.DWORD), ("biWidth", wintypes.LONG),
                ("biHeight", wintypes.LONG), ("biPlanes", wintypes.WORD),
                ("biBitCount", wintypes.WORD), ("biCompression", wintypes.DWORD),
                ("biSizeImage", wintypes.DWORD), ("biXPelsPerMeter", wintypes.LONG),
                ("biYPelsPerMeter", wintypes.LONG), ("biClrUsed", wintypes.DWORD),
                ("biClrImportant", wintypes.DWORD),
            ]

        class BMI(ctypes.Structure):
            _fields_ = [("bmiHeader", BMIH), ("bmiColors", ctypes.c_uint32 * 3)]

        bmi = BMI()
        bmi.bmiHeader.biSize = ctypes.sizeof(BMIH)
        bmi.bmiHeader.biWidth = w
        bmi.bmiHeader.biHeight = -h            # top-down
        bmi.bmiHeader.biPlanes = 1
        bmi.bmiHeader.biBitCount = 32
        bmi.bmiHeader.biCompression = 0        # BI_RGB
        buf = ctypes.create_string_buffer(w * h * 4)
        got = gdi32.GetDIBits(mem, bmp, 0, h, buf, ctypes.byref(bmi), 0)
        info["getdibits_lines"] = got
        raw = buf.raw
        stride = w * 4
        # sample a checksum so a black/no-desktop frame is detectable
        sample = sum(raw[0:min(len(raw), 400_000):97])
        info["pixel_checksum"] = sample
        rows = []
        for y in range(h):
            row = raw[y * stride:(y + 1) * stride]
            out = bytearray(w * 3)
            for x in range(w):
                b_, g_, r_ = row[x * 4], row[x * 4 + 1], row[x * 4 + 2]
                out[x * 3] = r_
                out[x * 3 + 1] = g_
                out[x * 3 + 2] = b_
            rows.append(bytes(out))
        ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
        rawdata = b"".join(b"\x00" + r for r in rows)
        png = (b"\x89PNG\r\n\x1a\n" + _png_chunk(b"IHDR", ihdr)
               + _png_chunk(b"IDAT", zlib.compress(rawdata, 6))
               + _png_chunk(b"IEND", b""))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(png)
        info["size_bytes"] = path.stat().st_size
        info["ok"] = True
    except BaseException as exc:  # noqa: BLE001
        info["ok"] = False
        info["error"] = f"{type(exc).__name__}: {exc}"[:220]
    return info


def _write_cert(proofs: Path, name: str, cert: dict) -> Path:
    proofs.mkdir(parents=True, exist_ok=True)
    p = proofs / name
    p.write_text(json.dumps(cert, ensure_ascii=False, indent=1), encoding="utf-8")
    return p


def _pump(root, frames: int, fps: int = 12) -> int:
    """Real event-loop frames (no mainloop — the selftest owns the flow)."""
    n = 0
    for _ in range(frames):
        try:
            root.update()
        except BaseException:  # noqa: BLE001
            break
        n += 1
        time.sleep(1.0 / fps)
    return n


# ----------------------------------------------------------- gate #6 UI


def ui_selftest(lm) -> int:
    """lm = the launcher module (NEXUS_ROOT, PROOFS, pick_runtime,
    generate_once, probe_core, PRODUCT, VERSION)."""
    import tkinter as tk
    from tkinter import scrolledtext

    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "gate6-desktop-ui",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(), "python": sys.version.split()[0],
                  "toolkit": "tkinter (stdlib)"}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p = _write_cert(Path(lm.PROOFS), "midpoint_ui.json", cert)
        print(f"certificate: {p}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "title", "tasks_count", "model",
                           "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    try:
        root = tk.Tk()
    except BaseException as exc:  # noqa: BLE001  (windowless service session)
        return _finish("FAIL", error=f"tk.Tk: {type(exc).__name__}: {exc}"[:260])

    title = f"NEXUS {lm.VERSION} — Windows Product"
    root.title(title)
    root.geometry("980x640+40+40")
    root.minsize(760, 520)
    cert["title"] = title

    # real task repository — the sidebar lists REAL persisted tasks
    tasks_count, task_lines = 0, []
    try:
        from nexus.core.persistence.repository import TaskRepository
        repo = TaskRepository(Path(lm.NEXUS_ROOT) / "tasks", create=False)
        summaries = repo.list_summaries()
        tasks_count = len(summaries)
        for s in summaries[:8]:
            task_lines.append(f"{str(s.state)} · {s.goal[:38]}")
    except BaseException as exc:  # noqa: BLE001
        task_lines.append(f"repository: {type(exc).__name__}: {exc}"[:80])

    # ---------------- layout
    root.grid_columnconfigure(1, weight=1)
    root.grid_rowconfigure(0, weight=1)
    side = tk.Frame(root, width=190, bd=1, relief="solid")
    side.grid(row=0, column=0, sticky="ns", padx=(6, 3), pady=6)
    side.grid_propagate(False)
    tk.Label(side, text="المحادثات", anchor="w", font=("Segoe UI", 10, "bold")).pack(fill="x", padx=6, pady=(6, 2))
    conv = tk.Listbox(side, height=3, exportselection=False)
    conv.pack(fill="x", padx=6)
    conv.insert("end", "أول مهمة حقيقية — MIDPOINT")
    tk.Label(side, text="المهام", anchor="w", font=("Segoe UI", 10, "bold")).pack(fill="x", padx=6, pady=(10, 2))
    tasks_lb = tk.Listbox(side, height=8, exportselection=False)
    tasks_lb.pack(fill="both", expand=True, padx=6, pady=(0, 6))
    for line in task_lines:
        tasks_lb.insert("end", line)
    tk.Label(side, text="NEXUS — جهازك بعقل", anchor="w", fg="#666").pack(fill="x", padx=6, pady=4)

    main = tk.Frame(root)
    main.grid(row=0, column=1, sticky="nsew", padx=6, pady=6)
    main.grid_rowconfigure(0, weight=3)
    main.grid_rowconfigure(1, weight=2)
    main.grid_columnconfigure(0, weight=1)
    tk.Label(main, text="المحادثة", anchor="w", font=("Segoe UI", 10, "bold")).grid(row=0, column=0, sticky="ew")
    chat = scrolledtext.ScrolledText(main, height=12, state="disabled", wrap="word", font=("Segoe UI", 10))
    chat.grid(row=0, column=0, sticky="nsew", pady=(24, 6))

    def chat_add(who: str, text: str) -> None:
        chat.configure(state="normal")
        chat.insert("end", f"{who}> {text}\n\n")
        chat.see("end")
        chat.configure(state="disabled")

    tk.Label(main, text="النشاط — Activity", anchor="w", font=("Segoe UI", 10, "bold")).grid(row=1, column=0, sticky="ew")
    act = scrolledtext.ScrolledText(main, height=7, state="disabled", wrap="word", font=("Consolas", 9))
    act.grid(row=1, column=0, sticky="nsew", pady=(24, 6))

    def act_add(line: str) -> None:
        act.configure(state="normal")
        act.insert("end", line + "\n")
        act.see("end")
        act.configure(state="disabled")

    composer = tk.Frame(root)
    composer.grid(row=1, column=0, columnspan=2, sticky="ew", padx=6, pady=(0, 6))
    composer.grid_columnconfigure(0, weight=1)
    entry = tk.Entry(composer, font=("Segoe UI", 10))
    entry.grid(row=0, column=0, sticky="ew", padx=(0, 6))
    status = tk.Label(root, text="…", anchor="w", bd=1, relief="sunken")
    status.grid(row=2, column=0, columnspan=2, sticky="ew")

    # ---------------- real content
    chat_add("أنت", "مرحباً يا NEXUS — عرّف نفسك بسطر واحد")
    act_add("[boot] core packages probed…")
    probes = lm.probe_core()
    ok_n = len(probes["ok"])
    act_add(f"[core] {ok_n} ok / {len(probes['err'])} err")
    for line in task_lines[:4]:
        act_add(f"[task] {line}")

    engine, base = lm.pick_runtime("http://127.0.0.1:8080")
    model_status = f"{engine} at {base}" if engine else "offline"
    if engine:
        try:
            payload_model = "qwen3-mini"
            reply = lm.generate_once(engine, base,
                                     "مرحباً يا NEXUS — عرّف نفسك بسطر واحد",
                                     payload_model)
            chat_add("nexus", reply[:600] or "(رد فارغ — صادق)")
        except BaseException as exc:  # noqa: BLE001
            chat_add("nexus", f"[فشل صادق] {type(exc).__name__}: {exc}"[:300])
    else:
        chat_add("nexus", "النموذج المحلي غير مشغّل الآن — النافذة حقيقية "
                          "والنواة متصلة، والرد سيأتي فور تشغيل النموذج (وضع صادق).")
    entry.insert(0, "حلل جهازي")
    status.config(text=f"Core: CONNECTED ({ok_n} pkgs)   ·   Model: {model_status}"
                       f"   ·   Tasks: {tasks_count}")

    frames = _pump(root, 30)

    # the visual proof — full desktop with the real window on it
    shot = grab_screen_png(Path(lm.PROOFS) / "midpoint_ui.png")
    cert["screenshot"] = shot
    cert["pump_frames"] = frames
    cert["tasks_count"] = tasks_count
    cert["model"] = model_status
    cert["core_ok"] = ok_n
    ok = (shot.get("ok") and (shot.get("size_bytes") or 0) > 8000
          and frames >= 20 and ok_n >= 30 and tasks_count >= 1)
    try:
        root.destroy()
    except BaseException:  # noqa: BLE001
        pass
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "see certificate fields")


# ---------------------------------------------------------- gate #7 tray


class _NOTIFYICONDATAW(ctypes.Structure):
    _fields_ = [
        ("cbSize", wintypes.DWORD), ("hWnd", wintypes.HWND),
        ("uID", ctypes.c_uint), ("uFlags", ctypes.c_uint),
        ("uCallbackMessage", ctypes.c_uint), ("hIcon", wintypes.HICON),
        ("szTip", ctypes.c_wchar * 128), ("dwState", wintypes.DWORD),
        ("dwStateMask", wintypes.DWORD), ("szInfo", ctypes.c_wchar * 256),
        ("uVersion", ctypes.c_uint), ("szInfoTitle", ctypes.c_wchar * 64),
        ("dwInfoFlags", wintypes.DWORD),
    ]


WNDPROC = ctypes.WINFUNCTYPE(ctypes.c_longlong, wintypes.HWND, ctypes.c_uint,
                             ctypes.c_longlong, ctypes.c_longlong)


class _WNDCLASSW(ctypes.Structure):
    _fields_ = [
        ("style", ctypes.c_uint), ("lpfnWndProc", WNDPROC),
        ("cbClsExtra", ctypes.c_int), ("cbWndExtra", ctypes.c_int),
        ("hInstance", wintypes.HINSTANCE), ("hIcon", wintypes.HICON),
        ("hCursor", ctypes.c_void_p), ("hbrBackground", wintypes.HBRUSH),
        ("lpszMenuName", wintypes.LPCWSTR), ("lpszClassName", wintypes.LPCWSTR),
    ]


def tray_selftest(lm) -> int:
    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "gate7-tray",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(),
                  "api": "Shell_NotifyIconW (ctypes, stdlib)"}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p = _write_cert(Path(lm.PROOFS), "midpoint_tray.json", cert)
        print(f"certificate: {p}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "add_ok", "modify_ok", "delete_ok",
                           "menu_items", "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    proc = WNDPROC(user32.DefWindowProcW)          # GC-anchor
    wc = _WNDCLASSW()
    wc.lpfnWndProc = proc
    wc.lpszClassName = "NEXUSTraySelftest"
    wc.hInstance = ctypes.windll.kernel32.GetModuleHandleW(None)
    if not user32.RegisterClassW(ctypes.byref(wc)):
        return _finish("FAIL", error=f"RegisterClassW: {ctypes.GetLastError()}")
    hwnd = user32.CreateWindowExW(0, wc.lpszClassName, "NEXUS tray host",
                                  0, 0, 0, 0, 0, None, None, wc.hInstance, None)
    if not hwnd:
        return _finish("FAIL", error=f"CreateWindowExW: {ctypes.GetLastError()}")

    hicon = shell32.ExtractIconW(0, sys.executable, 0)
    if not hicon:
        hicon = shell32.ExtractIconW(0, "imageres.dll", 0)
    cert["icon_source"] = "sys.executable" if hicon else "imageres.dll"

    nid = _NOTIFYICONDATAW()
    nid.cbSize = ctypes.sizeof(_NOTIFYICONDATAW)
    nid.hWnd = hwnd
    nid.uID = 1
    nid.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP
    nid.uCallbackMessage = WM_APP_TRAY
    nid.hIcon = hicon
    nid.szTip = "NEXUS — Ready"
    add_ok = bool(shell32.Shell_NotifyIconW(NIM_ADD, ctypes.byref(nid)))
    cert["add_ok"] = add_ok

    nid.szTip = "NEXUS — Working"
    mod_ok = bool(shell32.Shell_NotifyIconW(NIM_MODIFY, ctypes.byref(nid)))
    cert["modify_ok"] = mod_ok
    cert["states_shown"] = ["Ready", "Working"]

    # a REAL popup menu (built; display interaction belongs to a live run)
    hmenu = user32.CreatePopupMenu()
    items = ["فتح NEXUS", "إيقاف مؤقت", "استئناف", "خروج"]
    appended = []
    for i, label in enumerate(items, start=1):
        if user32.AppendMenuW(hmenu, MF_STRING, i, label):
            appended.append(label)
    cert["menu_items"] = appended

    # a real message pump — 3 seconds of PeekMessage/Dispatch
    msg = wintypes.MSG()
    end = time.time() + 3.0
    pumped = 0
    while time.time() < end:
        if user32.PeekMessageW(ctypes.byref(msg), None, 0, 0, PM_REMOVE):
            user32.TranslateMessage(ctypes.byref(msg))
            user32.DispatchMessageW(ctypes.byref(msg))
        else:
            pumped += 1
            time.sleep(0.05)
    cert["pump_iterations"] = pumped

    shot = grab_screen_png(Path(lm.PROOFS) / "midpoint_tray.png")
    cert["screenshot"] = shot
    cert["screenshot_note"] = ("full desktop — the tray icon may sit in the "
                               "overflow flyout (Win11); the API verdicts "
                               "here are the binding evidence")

    del_ok = bool(shell32.Shell_NotifyIconW(NIM_DELETE, ctypes.byref(nid)))
    cert["delete_ok"] = del_ok
    user32.DestroyMenu(hmenu)
    user32.DestroyWindow(hwnd)
    user32.UnregisterClassW(wc.lpszClassName, wc.hInstance)

    ok = add_ok and mod_ok and del_ok and len(appended) == 4 and shot.get("ok")
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "one of the tray API verdicts failed")


# -------------------------------------------------------- gate #8 overlay


def overlay_selftest(lm) -> int:
    import tkinter as tk

    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "gate8-overlay",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(),
                  "toolkit": "tkinter Toplevel topmost+alpha (stdlib)"}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p = _write_cert(Path(lm.PROOFS), "midpoint_overlay.json", cert)
        print(f"certificate: {p}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "topmost", "alpha", "pause_worked",
                           "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    try:
        root = tk.Tk()
        root.withdraw()
    except BaseException as exc:  # noqa: BLE001
        return _finish("FAIL", error=f"tk.Tk: {type(exc).__name__}: {exc}"[:260])

    ov = tk.Toplevel()
    ov.title("NEXUS overlay")
    ov.overrideredirect(True)
    ov.attributes("-topmost", True)
    try:
        ov.attributes("-alpha", 0.88)
    except BaseException:  # noqa: BLE001
        pass
    sw = ov.winfo_screenwidth()
    sh = ov.winfo_screenheight()
    w, h = 380, 96
    ov.geometry(f"{w}x{h}+{sw - w - 24}+{sh - h - 90}")
    ov.configure(bg="#101418")

    state = {"paused": False}
    label = tk.Label(ov, text="NEXUS is working — نكسس يعمل",
                     fg="#f5f5f4", bg="#101418", font=("Segoe UI", 12, "bold"))
    label.pack(pady=(10, 4))
    btns = tk.Frame(ov, bg="#101418")
    btns.pack()

    def _toggle(_=None) -> None:
        state["paused"] = not state["paused"]
        label.config(text=("NEXUS paused — نكسس متوقف مؤقتاً" if state["paused"]
                           else "NEXUS is working — نكسس يعمل"))

    pause_btn = tk.Button(btns, text="Pause", command=_toggle, width=9)
    pause_btn.pack(side="left", padx=6, pady=6)
    resume_btn = tk.Button(btns, text="Resume", command=_toggle, width=9)
    resume_btn.pack(side="left", padx=6, pady=6)

    cert["topmost"] = bool(int(ov.attributes("-topmost")))
    try:
        cert["alpha"] = round(float(ov.attributes("-alpha")), 2)
    except BaseException:  # noqa: BLE001
        cert["alpha"] = None

    f1 = _pump(ov, 25)
    pause_btn.invoke()               # REAL button press — state flips
    cert["pause_worked"] = state["paused"]
    label_text_after = label.cget("text")
    f2 = _pump(ov, 25)
    resume_btn.invoke()
    cert["resume_worked"] = not state["paused"]
    f3 = _pump(ov, 25)
    cert["pump_frames"] = [f1, f2, f3]
    cert["label_after_pause"] = label_text_after

    shot = grab_screen_png(Path(lm.PROOFS) / "midpoint_overlay.png")
    cert["screenshot"] = shot

    try:
        ov.destroy()
        root.destroy()
    except BaseException:  # noqa: BLE001
        pass
    ok = (cert.get("topmost") and cert.get("pause_worked")
          and cert.get("resume_worked") and shot.get("ok")
          and (shot.get("size_bytes") or 0) > 8000 and f3 >= 20)
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "overlay checks incomplete")
