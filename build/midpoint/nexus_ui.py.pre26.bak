# ------------------------------------------------------------------ PNG


def _png_chunk(tag: bytes, data: bytes) -> bytes:
    c = struct.pack(">I", len(data)) + tag + data
    return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)


def grab_screen_png(path: Path) -> dict:
    """Real full-screen capture → PNG (stdlib GDI). Honest result dict."""
    info: dict = {"method": "ctypes GDI BitBlt → GetDIBits → zlib PNG",
                  "path": str(path)}
    try:
        try:
            user32.SetProcessDPIAware()
        except BaseException:  # noqa: BLE001
            pass
        w = user32.GetSystemMetrics(0)
        h = user32.GetSystemMetrics(1)
        info["width"], info["height"] = w, h
        if w <= 0 or h <= 0:
            info["error"] = f"GetSystemMetrics gave {w}x{h} (no desktop?)"
            return info
        hdc = user32.GetDC(0)
        mem = gdi32.CreateCompatibleDC(hdc)
        bmp = gdi32.CreateCompatibleBitmap(hdc, w, h)
        gdi32.SelectObject(mem, bmp)
        gdi32.BitBlt(mem, 0, 0, w, h, hdc, 0, 0, SRCCOPY)

        class BMIH(ctypes.Structure):
            _fields_ = [
                ("biSize", wintypes.DWORD), ("biWidth", wintypes.LONG),
                ("biHeight", wintypes.LONG), ("biPlanes", wintypes.WORD),
                ("biBitCount", wintypes.WORD), ("biCompression", wintypes.DWORD),
                ("biSizeImage", wintypes.DWORD), ("biXPelsPerMeter", wintypes.LONG),
                ("biYPelsPerMeter", wintypes.LONG), ("biClrUsed", wintypes.DWORD),
                ("biClrImportant", wintypes.DWORD),
            ]

        class BMI(ctypes.Structure):
            _fields_ = [("bmiHeader", BMIH), ("bmiColors", ctypes.c_uint32 * 3)]

        bmi = BMI()
        bmi.bmiHeader.biSize = ctypes.sizeof(BMIH)
        bmi.bmiHeader.biWidth = w
        bmi.bmiHeader.biHeight = -h            # top-down
        bmi.bmiHeader.biPlanes = 1
        bmi.bmiHeader.biBitCount = 32
        bmi.bmiHeader.biCompression = 0        # BI_RGB
        buf = ctypes.create_string_buffer(w * h * 4)
        got = gdi32.GetDIBits(mem, bmp, 0, h, buf, ctypes.byref(bmi), 0)
        info["getdibits_lines"] = got
        raw = buf.raw
        stride = w * 4
        # sample a checksum so a black/no-desktop frame is detectable
        sample = sum(raw[0:min(len(raw), 400_000):97])
        info["pixel_checksum"] = sample
        rows = []
        for y in range(h):
            row = raw[y * stride:(y + 1) * stride]
            out = bytearray(w * 3)
            for x in range(w):
                b_, g_, r_ = row[x * 4], row[x * 4 + 1], row[x * 4 + 2]
                out[x * 3] = r_
                out[x * 3 + 1] = g_
                out[x * 3 + 2] = b_
            rows.append(bytes(out))
        ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
        rawdata = b"".join(b"\x00" + r for r in rows)
        png = (b"\x89PNG\r\n\x1a\n" + _png_chunk(b"IHDR", ihdr)
               + _png_chunk(b"IDAT", zlib.compress(rawdata, 6))
               + _png_chunk(b"IEND", b""))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(png)
        info["size_bytes"] = path.stat().st_size
        info["ok"] = True
    except BaseException as exc:  # noqa: BLE001
        info["ok"] = False
        info["error"] = f"{type(exc).__name__}: {exc}"[:220]
    return info


def _write_cert(proofs: Path, name: str, cert: dict) -> Path:
    proofs.mkdir(parents=True, exist_ok=True)
    p = proofs / name
    p.write_text(json.dumps(cert, ensure_ascii=False, indent=1), encoding="utf-8")
    return p


def _pump(root, frames: int, fps: int = 12) -> int:
    """Real event-loop frames (no mainloop — the selftest owns the flow)."""
    n = 0
    for _ in range(frames):
        try:
            root.update()
        except BaseException:  # noqa: BLE001
            break
        n += 1
        time.sleep(1.0 / fps)
    return n


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


# ===================================================================== v8


class MicRecorder:
    """Real microphone capture via winmm waveIn* (ctypes, stdlib only).

    Honest by construction: any failure returns {"ok": False, "error": …}
    — never a fake recording."""

    WAVE_MAPPER = -1
    CALLBACK_NULL = 0

    def __init__(self, seconds: float = 5.0, rate: int = 16000) -> None:
        self.seconds = float(seconds)
        self.rate = int(rate)
        self.winmm = ctypes.windll.winmm

    def record(self) -> dict:
        try:
            import wave as _wave

            class WAVEFORMATEX(ctypes.Structure):
                _fields_ = [
                    ("wFormatTag", ctypes.c_ushort), ("nChannels", ctypes.c_ushort),
                    ("nSamplesPerSec", ctypes.c_ulong), ("nAvgBytesPerSec", ctypes.c_ulong),
                    ("nBlockAlign", ctypes.c_ushort), ("wBitsPerSample", ctypes.c_ushort),
                    ("cbSize", ctypes.c_ushort),
                ]

            class WAVEHDR(ctypes.Structure):
                _fields_ = [
                    ("lpData", ctypes.c_char_p), ("dwBufferLength", ctypes.c_ulong),
                    ("dwBytesRecorded", ctypes.c_ulong), ("dwUser", ctypes.c_void_p),
                    ("dwFlags", ctypes.c_ulong), ("dwLoops", ctypes.c_ulong),
                    ("lpNext", ctypes.c_void_p), ("reserved", ctypes.c_void_p),
                ]

            fmt = WAVEFORMATEX()
            fmt.wFormatTag = 1            # PCM
            fmt.nChannels = 1
            fmt.nSamplesPerSec = self.rate
            fmt.wBitsPerSample = 16
            fmt.nBlockAlign = 2
            fmt.nAvgBytesPerSec = self.rate * 2
            fmt.cbSize = 0
            hwin = ctypes.c_void_p()
            rc = self.winmm.waveInOpen(
                ctypes.byref(hwin), ctypes.c_uint(0xFFFFFFFF), ctypes.byref(fmt),
                ctypes.c_void_p(), ctypes.c_void_p(), ctypes.c_uint(self.CALLBACK_NULL))
            if rc != 0:
                return {"ok": False, "error": f"waveInOpen rc={rc} (لا يوجد ميكروفون؟)"}
            nbuf = max(2, int(math.ceil(self.seconds / 0.5)))
            bufs, hdrs = [], []
            for _ in range(nbuf):
                b = ctypes.create_string_buffer(self.rate * 2)   # 0.5s of 16-bit mono
                bufs.append(b)
                h = WAVEHDR()
                h.lpData = ctypes.cast(b, ctypes.c_char_p)
                h.dwBufferLength = self.rate * 2
                hdrs.append(h)
            for h in hdrs:
                self.winmm.waveInPrepareHeader(hwin, ctypes.byref(h), ctypes.sizeof(WAVEHDR))
                self.winmm.waveInAddBuffer(hwin, ctypes.byref(h), ctypes.sizeof(WAVEHDR))
            rc = self.winmm.waveInStart(hwin)
            if rc != 0:
                self.winmm.waveInClose(hwin)
                return {"ok": False, "error": f"waveInStart rc={rc}"}
            time.sleep(self.seconds)
            self.winmm.waveInReset(hwin)
            pcm = bytearray()
            for h in hdrs:
                got = int(h.dwBytesRecorded or 0)
                if got:
                    pcm += bufs[hdrs.index(h)].raw[:got]
                self.winmm.waveInUnprepareHeader(hwin, ctypes.byref(h), ctypes.sizeof(WAVEHDR))
            self.winmm.waveInClose(hwin)
            return {"ok": True, "pcm": bytes(pcm), "rate": self.rate,
                    "seconds": self.seconds, "channels": 1, "bits": 16}
        except BaseException as exc:  # noqa: BLE001
            return {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:200]}

    @staticmethod
    def save_wav(path: Path, pcm: bytes, rate: int) -> dict:
        try:
            import wave as _wave

            path.parent.mkdir(parents=True, exist_ok=True)
            with _wave.open(str(path), "wb") as w:
                w.setnchannels(1)
                w.setsampwidth(2)
                w.setframerate(rate)
                w.writeframes(pcm)
            return {"ok": True, "path": str(path), "size_bytes": path.stat().st_size}
        except BaseException as exc:  # noqa: BLE001
            return {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:200]}


class NEXUS26App:
    """The PHASE 26 desktop application — 11 real sections over the real core."""

    def __init__(self, root, lm, selftest: bool = False) -> None:
        import tkinter as tk
        from tkinter import ttk

        self.tk = tk
        self.ttk = ttk
        self.lm = lm
        self.selftest = selftest
        self.q: "queue.Queue[tuple]" = queue.Queue()
        self.checks: dict = {}
        self.cap_clicks = {"n": 0}
        self.attachments: list[dict] = []
        # activity infra MUST exist before anything can emit an event
        self._activity_n = 0
        self._hist: list[str] = []
        self._bus_events: list[str] = []
        self.act_widget = None
        self.data: dict = {}
        self.current = "chat"
        self.current_title = "محادثة"
        T = THEME

        self.root = root
        root.title(f"NEXUS {lm.VERSION} — PHASE 26 · Desktop UI Production")
        root.geometry("1180x720+30+30")
        root.minsize(980, 600)
        root.configure(bg=T["bg"])

        # settings first — everything else reads them
        self.settings: dict = self.settings_load()

        # ---------- topbar
        top = tk.Frame(root, bg=T["bg"])
        top.grid(row=0, column=0, columnspan=2, sticky="ew", padx=6, pady=(6, 2))
        tk.Label(top, text=f"{lm.PRODUCT} · NEXUS {lm.VERSION}",
                 bg=T["bg"], fg=T["fg"], font=("Segoe UI", 11, "bold"),
                 anchor="w").pack(side="right")
        self.lbl_section = tk.Label(top, text="محادثة", bg=T["bg"], fg=T["accent"],
                                    font=("Segoe UI", 11, "bold"), anchor="e")
        self.lbl_section.pack(side="left")

        # ---------- nav
        nav = tk.Frame(root, bg=T["panel2"], bd=1, relief="solid", width=150)
        nav.grid(row=1, column=0, sticky="ns", padx=(6, 3), pady=2)
        nav.grid_propagate(False)
        self.nav_btns: dict = {}
        tk.Label(nav, text="الأقسام — 26.1 → 26.11", bg=T["panel2"], fg=T["fg_dim"],
                 font=("Segoe UI", 8)).pack(fill="x", pady=(4, 6))
        for i, (sid, title) in enumerate(SECTIONS):
            b = tk.Label(nav, text=f"{i + 1}. {title}", bg=T["panel2"], fg=T["fg"],
                         font=("Segoe UI", 10), anchor="w", cursor="hand2",
                         padx=10, pady=6)
            b.pack(fill="x")
            b.bind("<Button-1>", lambda _e, s=sid: self.show(s))
            self.nav_btns[sid] = b

        # ---------- content container
        self.container = tk.Frame(root, bg=T["bg"])
        self.container.grid(row=1, column=1, sticky="nsew", padx=(3, 6), pady=2)
        root.grid_rowconfigure(1, weight=1)
        root.grid_columnconfigure(1, weight=1)

        # ---------- statusbar
        self.status = tk.Label(root, text="…", anchor="w", bd=1, relief="sunken",
                               bg=T["panel"], fg=T["fg_dim"], font=("Segoe UI", 9))
        self.status.grid(row=2, column=0, columnspan=2, sticky="ew", padx=6, pady=(2, 6))

        # ---------- data layer (real)
        self.runtime = None
        self.boot_error = None
        self.tasks_summaries: list = []
        self.conversations: list = []
        self._boot_core()
        self._load_repo()

        # ---------- build all sections (lazy frames, built once)
        self.frames: dict = {}
        builders = {
            "chat": self._sec_chat, "conversations": self._sec_conversations,
            "tasks": self._sec_tasks, "activity": self._sec_activity,
            "models": self._sec_models, "workspace": self._sec_workspace,
            "memory": self._sec_memory, "checkpoints": self._sec_checkpoints,
            "settings": self._sec_settings, "voice": self._sec_voice,
            "attachments": self._sec_attachments,
        }
        for sid, fn in builders.items():
            f = tk.Frame(self.container, bg=T["bg"])
            self.frames[sid] = f
            try:
                fn(f)
            except BaseException as exc:  # noqa: BLE001
                tk.Label(f, text=f"قسم {sid}: فشل بناء صادق — {type(exc).__name__}: {exc}"[:300],
                         bg=T["bg"], fg=T["danger"], font=("Segoe UI", 9), wraplength=800,
                         justify="right").pack(padx=12, pady=12, anchor="e")
                self.checks[f"build:{sid}"] = f"{type(exc).__name__}: {exc}"[:160]

        # poll the worker queue (threads → UI)
        self.root.after(150, self._drain)
        self.show("chat")

    # ------------------------------------------------------------ helpers

    def activity(self, line: str) -> None:
        self._activity_n += 1
        stamp = time.strftime("%H:%M:%S")
        full = f"{stamp}  {line}"
        self._hist.append(full)
        if self.act_widget is not None:
            w = self.act_widget
            w.configure(state="normal")
            w.insert("end", f"{stamp}  {line}\n")
            w.see("end")
            w.configure(state="disabled")
        try:  # real bus event — the Activity section is also event-fed
            if self.runtime is not None:
                self.runtime.bus.publish("ui.activity", payload={"line": line[:200]},
                                         source="nexus_ui")
        except BaseException:
            pass

    def _drain(self) -> None:
        try:
            while True:
                kind, payload = self.q.get_nowait()
                if kind == "chat":
                    self.chat_add("nexus", payload)
                elif kind == "task_done":
                    self.activity(f"[task] اكتملت: {payload.get('task_id', '')[:20]} — {payload.get('summary', '')[:60]}")
                    self._load_repo()
                    self._fill_tasks()
                    self._set_status()
                elif kind == "task_fail":
                    self.activity(f"[task-fail] {payload}"[:240])
                elif kind == "attach":
                    self.activity(f"[attach] {payload}"[:200])
        except queue.Empty:
            pass
        try:
            self.root.after(150, self._drain)
        except BaseException:
            pass

    def _set_status(self) -> None:
        model = self.data.get("model_status", "…")
        self.status.config(text=f"Core: {self.core_line}   ·   Model: {model}"
                                f"   ·   Tasks: {len(self.tasks_summaries)}"
                                f"   ·   Section: {getattr(self, 'current_title', '')}")

    # ------------------------------------------------------- core / data

    def _boot_core(self) -> None:
        probes = self.lm.probe_core()
        self.core_ok = len(probes.get("ok", []))
        self.core_err = len(probes.get("err", []))
        self.core_line = f"CONNECTED ({self.core_ok} pkgs)" if self.core_ok >= 30 else f"DEGRADED ({self.core_ok})"
        self.activity(f"[boot] core packages probed: {self.core_ok} ok / {self.core_err} err")
        try:
            from nexus.core.config.runtime import NexusRuntime
            self.runtime = NexusRuntime.boot(root=self.lm.NEXUS_ROOT)
            self.activity("[boot] NexusRuntime.boot — النواة الحية تعمل (bus/session/engine/repo)")
            try:
                self.runtime.bus.subscribe(
                    "*", lambda ev: self._on_bus_event(ev))
            except BaseException:
                pass
            try:
                hist = self.runtime.bus.history_snapshot()
                self.activity(f"[bus] history snapshot: {len(hist)} events real")
            except BaseException:
                pass
        except BaseException as exc:  # noqa: BLE001
            self.runtime = None
            self.boot_error = f"{type(exc).__name__}: {exc}"[:240]
            self.activity(f"[boot-fail] NexusRuntime: {self.boot_error}")

    def _on_bus_event(self, ev) -> None:
        try:
            name = str(getattr(ev, "name", "?"))
            src = str(getattr(ev, "source", "") or "")
            self._bus_events.append(f"{name} ← {src}"[:120])
        except BaseException:
            pass

    def _load_repo(self) -> None:
        self.tasks_summaries = []
        try:
            from nexus.core.persistence.repository import TaskRepository
            repo = TaskRepository(Path(self.lm.NEXUS_ROOT) / "tasks", create=False)
            self.tasks_summaries = list(repo.list_summaries())
            self.activity(f"[repo] {len(self.tasks_summaries)} مهمة حقيقية من المستودع")
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[repo-err] {type(exc).__name__}: {exc}"[:180])

    # ================================================== 26.1 Chat

    def _sec_chat(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(2, weight=1)

        # project card (MIDPOINT product card — preserved)
        proj = tk.Frame(parent, bd=1, relief="solid", bg=T["panel"])
        proj.grid(row=0, column=0, sticky="ew", pady=(0, 4))
        tk.Label(proj, text=f"{self.lm.PRODUCT}  ·  NEXUS {self.lm.VERSION}",
                 bg=T["panel"], fg=T["fg"], font=("Segoe UI", 10, "bold"),
                 anchor="e").pack(fill="x", padx=8, pady=(4, 0))
        tk.Label(proj, text="PHASE 26 · 26.1 Chat · MIDPOINT 10/10 ✅ · 28 حزمة نواة · local-first · جهازك بعقل",
                 bg=T["panel"], fg=T["fg_dim"], font=("Segoe UI", 8),
                 anchor="e").pack(fill="x", padx=8, pady=(0, 4))

        # capability cards (MIDPOINT-10 — preserved, still seeding the composer)
        caps_bar = tk.Frame(parent, bd=1, relief="solid", bg=T["bg"])
        caps_bar.grid(row=1, column=0, sticky="ew", pady=(0, 4))
        self.entry = None  # created below; _seed_cap resolves late

        for _i, (_t, _h, _c) in enumerate(CAPS):
            card = tk.Frame(caps_bar, bd=1, relief="solid", cursor="hand2", bg=T["panel"])
            card.grid(row=0, column=_i, padx=3, pady=3, sticky="nsew")
            caps_bar.grid_columnconfigure(_i, weight=1)
            tk.Label(card, text=_t, fg=_c, bg=T["panel"], font=("Segoe UI", 9, "bold"),
                     cursor="hand2").pack(padx=4, pady=(3, 0))
            tk.Label(card, text=_h, fg=T["fg_dim"], bg=T["panel"],
                     font=("Segoe UI", 7), cursor="hand2").pack(padx=4, pady=(0, 3))
            _seed = CAP_SEEDS[_t]
            card.bind("<Button-1>", lambda _e, t=_t, s=_seed: self.cap_seed(t, s))
            for _w in card.winfo_children():
                _w.bind("<Button-1>", lambda _e, t=_t, s=_seed: self.cap_seed(t, s))

        tk.Label(parent, text="المحادثة — Chat", anchor="e", bg=T["bg"], fg=T["fg"],
                 font=("Segoe UI", 10, "bold")).grid(row=2, column=0, sticky="ew")
        from tkinter import scrolledtext
        chat = scrolledtext.ScrolledText(parent, height=10, state="disabled",
                                         wrap="word", font=("Segoe UI", 10),
                                         bg=T["entry_bg"], fg=T["fg"])
        chat.grid(row=2, column=0, sticky="nsew", pady=(26, 4))
        self.chat_widget = chat

        chips = tk.Frame(parent, bg=T["bg"])
        chips.grid(row=3, column=0, sticky="ew")
        self.chips_frame = chips

        comp = tk.Frame(parent, bg=T["bg"])
        comp.grid(row=4, column=0, sticky="ew", pady=(4, 0))
        comp.grid_columnconfigure(0, weight=1)
        entry = tk.Entry(comp, font=("Segoe UI", 10), bg=T["entry_bg"], fg=T["fg"],
                         insertbackground=T["fg"])
        entry.grid(row=0, column=0, sticky="ew", padx=(0, 6))
        self.entry = entry
        tk.Button(comp, text="إرسال", command=self.chat_send, width=10,
                  bg=T["accent"], fg="#06281F", font=("Segoe UI", 9, "bold")
                  ).grid(row=0, column=1)

        self.chat_add("أنت", "مرحباً يا NEXUS — PHASE 26 وصلت. عرّف نفسك.")
        self.entry.insert(0, "حلل جهازي")

    def cap_seed(self, title: str, seed: str) -> None:
        self.cap_clicks["n"] += 1
        if self.entry is not None:
            self.entry.delete(0, "end")
            self.entry.insert(0, seed)
            try:
                self.entry.focus_set()
            except BaseException:
                pass
        self.activity(f"[cap] {title} — بُذّر الـcomposer (ليست mode مغلقة)")

    def chat_add(self, who: str, text: str) -> None:
        w = getattr(self, "chat_widget", None)
        if w is None:
            return
        w.configure(state="normal")
        w.insert("end", f"{who}> {text}\n\n")
        w.see("end")
        w.configure(state="disabled")

    def chat_send(self) -> None:
        text = self.entry.get().strip()
        if not text:
            return
        self.entry.delete(0, "end")
        self.chat_add("أنت", text)
        self.activity(f"[chat] أُرسلت رسالة ({len(text)} حرفاً)")
        threading.Thread(target=self._chat_worker, args=(text,), daemon=True).start()

    def _chat_worker(self, text: str) -> None:
        try:
            engine, base = self.lm.pick_runtime(self.settings.get("model_base", "http://127.0.0.1:8080"))
            self.data["model_status"] = f"{engine} at {base}" if engine else "offline"
            if not engine:
                self.q.put(("chat", "النموذج المحلي غير مشغّل الآن — النافذة حقيقية والنواة "
                                   "متصلة، والرد سيأتي فور تشغيل النموذج (وضع صادق)."))
                return
            self.q.put(("status", None))
            reply = self.lm.generate_once(engine, base, text,
                                          self.settings.get("ollama_model", "qwen3:0.6b"))
            self.q.put(("chat", reply[:900] if reply else "(رد فارغ — صادق)"))
        except BaseException as exc:  # noqa: BLE001
            self.q.put(("chat", f"[فشل صادق] {type(exc).__name__}: {exc}"[:280]))

    # ================================================== 26.2 Conversations

    def _sec_conversations(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(2, weight=1)
        tk.Label(parent, text="المحادثات — Conversations (26.2)", anchor="e",
                 bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        info = tk.Label(parent, text="", anchor="e", bg=T["bg"], fg=T["fg_dim"],
                        font=("Segoe UI", 8))
        info.grid(row=1, column=0, sticky="ew")
        self.conv_info = info
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=12, state="disabled",
                                       wrap="word", font=("Segoe UI", 10),
                                       bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=2, column=0, sticky="nsew", pady=4)
        self.conv_widget = lb
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=3, column=0, sticky="ew")
        bar.grid_columnconfigure(0, weight=1)
        self.conv_entry = tk.Entry(bar, font=("Segoe UI", 10), bg=T["entry_bg"], fg=T["fg"],
                                   insertbackground=T["fg"])
        self.conv_entry.grid(row=0, column=0, sticky="ew", padx=(0, 6))
        self.conv_entry.insert(0, "محادثة جديدة")
        tk.Button(bar, text="محادثة جديدة (حقيقية)", command=self.conversation_create,
                  bg=T["accent"], fg="#06281F", font=("Segoe UI", 9, "bold")
                  ).grid(row=0, column=1)
        self._fill_conversations()

    def conversation_create(self) -> None:
        title = self.conv_entry.get().strip() or "محادثة"
        try:
            sm = self.runtime.session_manager
            if not getattr(self, "_user", None):
                self._user = sm.create_user(display_name="Mohammad")
            conv = sm.create_conversation(self._user, title=title[:80])
            self.conversations.append(conv)
            self._fill_conversations()
            self.activity(f"[conv] أُنشئت محادثة حقيقية: {conv.id} — {title[:40]}")
            return conv
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[conv-err] {type(exc).__name__}: {exc}"[:200])
            return None

    def _fill_conversations(self) -> None:
        w = self.conv_widget
        w.configure(state="normal")
        w.delete("1.0", "end")
        for c in self.conversations:
            w.insert("end", f"• {c.id}  ·  {c.title}  ·  {len(c.task_ids)} مهمة\n")
        persisted = "\n".join(
            f"◦ مهمة محفوظة: {str(s.goal)[:48]}  [{str(s.state).split('.')[-1]}]"
            for s in self.tasks_summaries[:12])
        w.insert("end", "\n— سجل المهام المحفوظة (من المستودع الحقيقي) —\n" + (persisted or "(فارغ)"))
        w.configure(state="disabled")
        try:
            self.conv_info.config(text=f"محادثات حية في هذه الجلسة: {len(self.conversations)}"
                                       f"  ·  مهام محفوظة: {len(self.tasks_summaries)}")
        except BaseException:
            pass

    # ================================================== 26.3 Tasks

    def _sec_tasks(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(1, weight=1)
        tk.Label(parent, text="المهام — Tasks (26.3) عبر محرك الحالات الحقيقي", anchor="e",
                 bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=11, state="disabled",
                                       wrap="word", font=("Consolas", 9),
                                       bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=1, column=0, sticky="nsew", pady=4)
        self.tasks_widget = lb
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=2, column=0, sticky="ew")
        bar.grid_columnconfigure(0, weight=1)
        self.task_entry = tk.Entry(bar, font=("Segoe UI", 10), bg=T["entry_bg"], fg=T["fg"],
                                   insertbackground=T["fg"])
        self.task_entry.grid(row=0, column=0, sticky="ew", padx=(0, 6))
        self.task_entry.insert(0, "اعمل مجلد باسم phase26-ui وضع داخله ملف نصي")
        tk.Button(bar, text="نفّذ المهمة (محرك حقيقي)", command=self.task_run,
                  bg=T["accent2"], fg="#3B2200", font=("Segoe UI", 9, "bold")
                  ).grid(row=0, column=1)
        tk.Button(bar, text="تحديث", command=self._fill_tasks, width=8
                  ).grid(row=0, column=2, padx=(6, 0))
        self._fill_tasks()

    def _fill_tasks(self) -> None:
        w = getattr(self, "tasks_widget", None)
        if w is None:
            return
        w.configure(state="normal")
        w.delete("1.0", "end")
        for s in self.tasks_summaries[:20]:
            sid = getattr(s, "id", "?")
            st = str(getattr(s, "state", "?")).split(".")[-1]
            w.insert("end", f"[{st:<10}] {sid[:26]}  ·  {str(getattr(s, 'goal', ''))[:52]}\n")
        w.configure(state="disabled")
        self._set_status()

    def task_run(self) -> None:
        goal = self.task_entry.get().strip()
        if not goal:
            return
        self.activity(f"[task] بدء تنفيذ حقيقي: {goal[:60]}")
        threading.Thread(target=self._task_worker, args=(goal,), daemon=True).start()

    def _task_worker(self, goal: str) -> None:
        """The real M4 loop inside the UI: boot → hierarchy → engine →
        Router → filesystem → verify → persist. Honest errors only."""
        try:
            from nexus.core.engine.states import TaskState
            from nexus.core.session.models import (
                StepStatus, TaskPlan, TaskResult, VerificationCheck, VerificationStatus)
            from nexus.tools import build_tool_system

            ws = Path(self.settings.get("workspace_root", "M:/NEXUS-Test"))
            safe = "ui_" + time.strftime("%Y%m%d_%H%M%S")
            folder_rel = safe
            file_rel = folder_rel + "/nexus_task_note.txt"
            runtime = self.runtime or self._reboot_runtime()
            registry, router, _a, _rep = build_tool_system(
                workspace_root=ws, bus=runtime.bus,
                resources=runtime.resource_manager,
                confirm_danger_above=2, allow_network=False)
            sm = runtime.session_manager
            user = getattr(self, "_user", None) or sm.create_user(display_name="Mohammad")
            self._user = user
            conv = sm.create_conversation(user, title=f"UI task — {goal[:40]}")
            task = sm.create_task(conv, goal=goal, prompt=goal)
            engine = runtime.engine
            note = (f"هذا الملف نفّذته واجهة NEXUS بنفسها — PHASE 26 UI task.\n"
                    f"task_id: {task.id}\ngoal: {goal}\n"
                    f"utc: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n")
            engine.start(task, reason="ui task started")
            task.plan = TaskPlan.from_steps(["make_dirs", "write_text", "verify"])
            engine.transition(task, TaskState.PLANNING, reason="ui plan of 3")
            engine.transition(task, TaskState.EXECUTING, reason="ui executing")
            o_dir = router.route("filesystem", {"op": "make_dirs", "path": folder_rel},
                                 task_id=task.id, agent_id="nexus_ui")
            o_txt = router.route("filesystem", {"op": "write_text", "path": file_rel,
                                                "content": note},
                                 task_id=task.id, agent_id="nexus_ui")
            engine.transition(task, TaskState.VERIFYING, reason="ui verify")
            filep = ws / file_rel
            read_back = filep.read_text(encoding="utf-8") if filep.is_file() else ""
            checks = [
                ("folder", (ws / folder_rel).is_dir(), str(ws / folder_rel)),
                ("file", filep.is_file(), str(filep)),
                ("roundtrip", read_back == note, f"{len(read_back)} chars"),
                ("router_dir", o_dir.ok, f"{o_dir.elapsed_ms}ms"),
                ("router_txt", o_txt.ok, f"{o_txt.elapsed_ms}ms"),
            ]
            task.verification.checks = [VerificationCheck(name=n, passed=bool(p), detail=str(d)[:140])
                                        for n, p, d in checks]
            all_ok = all(p for _, p, _ in checks)
            task.verification.status = (VerificationStatus.PASSED if all_ok
                                        else VerificationStatus.FAILED)
            if all_ok:
                engine.transition(task, TaskState.COMPLETED, reason="ui verification passed")
                task.result = TaskResult(summary="مهمة UI اكتملت بتحقق كامل",
                                         artifacts=[str(filep)], success=True)
                runtime.repository.save(task)
                self.q.put(("task_done", {"task_id": task.id, "summary": "COMPLETED + saved"}))
            else:
                failed = [n for n, p, _ in checks if not p]
                self.q.put(("task_fail", f"verification failed: {failed}"))
        except BaseException as exc:  # noqa: BLE001
            self.q.put(("task_fail", f"{type(exc).__name__}: {exc}"[:220]))

    def _reboot_runtime(self):
        from nexus.core.config.runtime import NexusRuntime
        self.runtime = NexusRuntime.boot(root=self.lm.NEXUS_ROOT)
        return self.runtime

    # ================================================== 26.4 Activity

    def _sec_activity(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(1, weight=1)
        tk.Label(parent, text="النشاط — Activity (26.4) — أحداث الحافلة الحقيقية + أحداث الواجهة",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        from tkinter import scrolledtext
        act = scrolledtext.ScrolledText(parent, height=14, state="disabled",
                                        wrap="word", font=("Consolas", 9),
                                        bg=T["entry_bg"], fg=T["fg"])
        act.grid(row=1, column=0, sticky="nsew", pady=4)
        self.act_widget = act
        for _line in list(self._hist)[-200:]:
            act.configure(state="normal")
            act.insert("end", _line + "\n")
        act.see("end")
        act.configure(state="disabled")
        self.activity("[activity] قسم النشاط عاش — يعرض الأحداث الحية")

    # ================================================== 26.5 Models

    def _sec_models(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(2, weight=1)
        tk.Label(parent, text="النماذج — Models (26.5) — سلم التشغيل الحقيقي MODE A → A2",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        self.models_status = tk.Label(parent, text="…فحص…", anchor="e", bg=T["bg"],
                                      fg=T["accent2"], font=("Segoe UI", 10, "bold"))
        self.models_status.grid(row=1, column=0, sticky="ew")
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=9, state="disabled", wrap="word",
                                       font=("Consolas", 9), bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=2, column=0, sticky="nsew", pady=4)
        self.models_widget = lb
        tk.Label(parent, text="العتاد: i7-3770 (AVX بلا AVX2) · GTX 750 Ti 4GB · Ollama MODE A2 · local-first",
                 anchor="e", bg=T["bg"], fg=T["fg_dim"], font=("Segoe UI", 8)
                 ).grid(row=3, column=0, sticky="ew")
        self.models_probe()

    def models_probe(self) -> None:
        w = getattr(self, "models_widget", None)
        if w is None:
            return
        lines: list[str] = []
        rt = self.lm.probe_model_runtime(self.settings.get("model_base", "http://127.0.0.1:8080"))
        ol = self.lm.probe_ollama()
        if rt.get("up"):
            lines.append(f"llama-server MODE A  : UP  ·  {rt['base']}")
        else:
            lines.append(f"llama-server MODE A  : down · {rt.get('error', '')[:70]}")
        if ol.get("up"):
            lines.append(f"Ollama MODE A2       : UP  ·  {ol['base']} · {str(ol.get('version', ''))[:40]}")
            try:
                import urllib.request
                opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
                with opener.open(ol["base"] + "/api/tags", timeout=4) as r:
                    tags = json.loads((r.read() or b"{}").decode("utf-8", "replace"))
                for m in (tags.get("models") or [])[:10]:
                    lines.append(f"  · {m.get('name', '?')}  ({round((m.get('size') or 0) / 1e9, 2)} GB)")
                self.data["ollama_models"] = [m.get("name", "?") for m in (tags.get("models") or [])]
            except BaseException as exc:  # noqa: BLE001
                lines.append(f"  /api/tags: {type(exc).__name__}: {exc}"[:90])
        else:
            lines.append(f"Ollama MODE A2       : down · {ol.get('error', '')[:70]}")
        try:
            mm = self.runtime.model_manager
            lines.append(f"ModelManager (core)  : {type(mm).__name__} حي — السجل الداخلي جاهز")
        except BaseException as exc:  # noqa: BLE001
            lines.append(f"ModelManager (core)  : {type(exc).__name__}"[:90])
        engine, base = self.lm.pick_runtime(self.settings.get("model_base", "http://127.0.0.1:8080"))
        self.data["model_status"] = f"{engine} at {base}" if engine else "offline"
        self.models_status.config(
            text=("النموذج: " + self.data["model_status"] if engine
                  else "النموذج: offline — صادق (شغّل Ollama أو llama-server)"))
        w.configure(state="normal")
        w.delete("1.0", "end")
        w.insert("end", "\n".join(lines) + "\n")
        w.configure(state="disabled")
        self.activity(f"[models] probe — {'UP' if engine else 'offline'}")
        self._set_status()

    # ================================================== 26.6 Workspace

    def _sec_workspace(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(1, weight=1)
        tk.Label(parent, text="مساحة العمل — Workspace (26.6) — أقراص حقيقية من مساحة NEXUS",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        from tkinter import ttk
        style = ttk.Style()
        try:
            style.theme_use("clam")
            style.configure("N26.Treeview", background=T["entry_bg"], fieldbackground=T["entry_bg"],
                            foreground=T["fg"])
            style.configure("N26.Treeview.Heading", background=T["panel"], foreground=T["fg"])
        except BaseException:
            pass
        tree = ttk.Treeview(parent, style="N26.Treeview", show="tree headings", columns=("size", "mtime"))
        tree.heading("#0", text="المسار", anchor="e")
        tree.column("#0", width=430, anchor="w")
        tree.heading("size", text="البايتات")
        tree.heading("mtime", text="آخر تعديل")
        tree.grid(row=1, column=0, sticky="nsew", pady=4)
        self.workspace_tree = tree
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=2, column=0, sticky="ew")
        tk.Button(bar, text="تحديث", command=self._fill_workspace
                  ).pack(side="left", padx=2)
        tk.Button(bar, text="افتح المجلد", command=self._workspace_open
                  ).pack(side="left", padx=2)
        self._fill_workspace()

    def _workspace_roots(self) -> list[Path]:
        roots = [Path(self.settings.get("workspace_root", "M:/NEXUS-Test"))]
        nroot = Path(self.lm.NEXUS_ROOT)
        for rel in ("tasks", "attachments", "voice", "checkpoints"):
            roots.append(nroot / rel)
        return roots

    def _fill_workspace(self) -> None:
        tree = getattr(self, "workspace_tree", None)
        if tree is None:
            return
        tree.delete(*tree.get_children())
        count = 0
        for root_dir in self._workspace_roots():
            rid = tree.insert("", "end", text=str(root_dir), open=False,
                              values=("", ""))
            try:
                for entry in sorted(root_dir.iterdir(), key=lambda e: e.name)[:60]:
                    try:
                        st = entry.stat()
                        tree.insert(rid, "end", text=entry.name,
                                    values=(st.st_size if entry.is_file() else "<dir>",
                                            time.strftime("%m-%d %H:%M", time.localtime(st.st_mtime))))
                        count += 1
                    except OSError:
                        pass
            except OSError as exc:
                tree.insert(rid, "end", text=f"(غير متاح: {type(exc).__name__})")
        self.data["workspace_entries"] = count
        self.activity(f"[workspace] {count} مدخل حقيقي من القرص")

    def _workspace_open(self) -> None:
        try:
            os.startfile(str(self._workspace_roots()[0]))  # noqa: S606
            self.activity("[workspace] فُتح المجلد في Explorer")
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[workspace-open-err] {type(exc).__name__}: {exc}"[:160])

    # ================================================== 26.7 Memory

    def _sec_memory(self, parent) -> None:
