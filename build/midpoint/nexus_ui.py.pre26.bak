    def _memory_path(self) -> Path:
        return Path(self.lm.NEXUS_ROOT) / "ui_memory.json"

    def memory_core_probe(self) -> None:
        """Real probe of the core memory package — recorded honestly."""
        rec: dict = {"import": "err", "sqlite": "err"}
        try:
            from nexus.memory import SCHEMA_VERSION, SQLiteMemoryStore
            rec["import"] = "ok"
            store = SQLiteMemoryStore()          # in-memory by design (default arg)
            rec["sqlite"] = f"ok · schema v{SCHEMA_VERSION} · {type(store).__name__}"
        except BaseException as exc:  # noqa: BLE001
            rec["sqlite"] = f"{type(exc).__name__}: {exc}"[:120]
        self.data["memory_core"] = rec
        self.memory_core_lbl.config(
            text=f"nexus.memory: import={rec['import']} · SQLiteMemoryStore={rec['sqlite']}")
        self.activity(f"[memory] core probe — sqlite: {rec['sqlite'][:60]}")

    def memory_remember(self, note: str) -> dict:
        data = {"notes": []}
        p = self._memory_path()
        try:
            if p.is_file():
                data = json.loads(p.read_text(encoding="utf-8"))
        except BaseException:
            data = {"notes": []}
        rec = {"text": note, "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        data.setdefault("notes", []).append(rec)
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
        with open(tmp, "rb") as fh:
            os.fsync(fh.fileno())
        os.replace(tmp, p)
        self.activity(f"[memory] تذكّر: {note[:50]}")
        self._memory_fill()
        return rec

    def memory_remember_btn(self) -> None:
        note = self.memory_entry.get().strip()
        if note:
            self.memory_remember(note)

    def memory_search(self, needle: str) -> list[dict]:
        p = self._memory_path()
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
        except BaseException:
            return []
        hits = [n for n in data.get("notes", []) if needle.lower() in str(n.get("text", "")).lower()]
        self.activity(f"[memory] بحث عن '{needle[:40]}': {len(hits)} نتيجة")
        return hits

    def memory_search_btn(self) -> None:
        needle = self.memory_entry.get().strip()
        if not needle:
            return
        hits = self.memory_search(needle)
        self._memory_fill(hits, f"نتائج البحث عن: {needle}")

    def _memory_fill(self, hits: list | None = None, title: str = "الملاحظات (ui_memory.json — حقيقية)") -> None:
        w = getattr(self, "memory_widget", None)
        if w is None:
            return
        w.configure(state="normal")
        w.delete("1.0", "end")
        w.insert("end", f"— {title} —\n")
        try:
            data = json.loads(self._memory_path().read_text(encoding="utf-8")) if self._memory_path().is_file() else {"notes": []}
        except BaseException:
            data = {"notes": []}
        notes = hits if hits is not None else list(reversed(data.get("notes", [])))
        for n in notes[:30]:
            w.insert("end", f"• {n.get('utc', '')}  ·  {str(n.get('text', ''))[:90]}\n")
        if not notes:
            w.insert("end", "(فارغ — بصدق)\n")
        w.configure(state="disabled")

    # ================================================== 26.8 Checkpoints

    def _sec_checkpoints(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(2, weight=1)
        tk.Label(parent, text="نقاط الحفظ — Checkpoints (26.8) — متجر النواة الحقيقي + لقطات UI على القرص",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        self.cp_dir_lbl = tk.Label(parent, text="…", anchor="e", bg=T["bg"],
                                   fg=T["fg_dim"], font=("Segoe UI", 8))
        self.cp_dir_lbl.grid(row=1, column=0, sticky="ew")
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=9, state="disabled", wrap="word",
                                       font=("Consolas", 9), bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=2, column=0, sticky="nsew", pady=4)
        self.cp_widget = lb
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=3, column=0, sticky="ew")
        tk.Button(bar, text="أنشئ نقطة حفظ الآن (لقطات حقيقية + manifest sha256)",
                  command=self.checkpoint_create, bg=T["accent"], fg="#06281F",
                  font=("Segoe UI", 9, "bold")).pack(side="left")
        self._cp_fill()

    def _checkpoint_dir(self) -> Path:
        try:
            if self.runtime is not None and self.runtime.paths.checkpoints is not None:
                return Path(self.runtime.paths.checkpoints)
        except BaseException:
            pass
        return Path(self.lm.NEXUS_ROOT) / "checkpoints"

    def checkpoint_create(self) -> dict:
        """REAL snapshot: tasks repository + settings + memory → cp_<utc> + manifest."""
        cp_dir = self._checkpoint_dir()
        stamp = time.strftime("%Y%m%d_%H%M%S")
        target = cp_dir / f"ui_cp_{stamp}"
        target.mkdir(parents=True, exist_ok=True)
        copied: list[dict] = []
        sources = [
            (Path(self.lm.NEXUS_ROOT) / "tasks", "tasks"),
            (self._memory_path(), "ui_memory.json"),
            (Path(self.lm.NEXUS_ROOT) / "ui_settings.json", "ui_settings.json"),
        ]
        for src, label in sources:
            try:
                if src.is_dir():
                    dst = target / label
                    shutil.copytree(src, dst, dirs_exist_ok=True)
                    for f in dst.rglob("*"):
                        if f.is_file():
                            copied.append({"file": f"{label}/{f.relative_to(dst)}",
                                           "sha256": _sha256_file(f), "size": f.stat().st_size})
                elif src.is_file():
                    dst = target / label
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(src, dst)
                    copied.append({"file": label, "sha256": _sha256_file(dst), "size": dst.stat().st_size})
            except BaseException as exc:  # noqa: BLE001
                copied.append({"file": label, "error": f"{type(exc).__name__}: {exc}"[:120]})
        manifest = {"checkpoint": target.name, "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                    "files": copied, "count": len(copied)}
        (target / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=1),
                                              encoding="utf-8")
        self.activity(f"[checkpoint] أُنشئت {target.name} — {len(copied)} ملف")
        self._cp_fill()
        return manifest

    def _cp_fill(self) -> None:
        w = getattr(self, "cp_widget", None)
        if w is None:
            return
        cp_dir = self._checkpoint_dir()
        self.cp_dir_lbl.config(text=f"مسار المتجر الحقيقي: {cp_dir}")
        w.configure(state="normal")
        w.delete("1.0", "end")
        n = 0
        try:
            for d in sorted(cp_dir.iterdir(), reverse=True):
                if d.is_dir():
                    n += 1
                    man = d / "manifest.json"
                    extra = ""
                    if man.is_file():
                        try:
                            m = json.loads(man.read_text(encoding="utf-8"))
                            extra = f" · {m.get('count', '?')} ملف"
                        except BaseException:
                            extra = " · manifest غير مقروء"
                    w.insert("end", f"• {d.name}{extra}\n")
        except OSError as exc:
            w.insert("end", f"(المجلد غير موجود بعد — صادق: {type(exc).__name__})\n")
        if n == 0:
            w.insert("end", "(لا نقاط حفظ بعد — بصدق)\n")
        w.configure(state="disabled")
        self.data["checkpoints_count"] = n

    # ================================================== 26.9 Settings

    def _sec_settings(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        for r in range(8):
            parent.grid_rowconfigure(r, weight=0)
        tk.Label(parent, text="الإعدادات — Settings (26.9) — ui_settings.json على القرص (كتابة ذرية)",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        self._set_entrys: dict = {}
        fields = [
            ("ollama_model", "موديل Ollama (MODE A2)"),
            ("model_base", "عنوان llama-server (MODE A)"),
            ("workspace_root", "جذر مساحة العمل"),
            ("voice_seconds", "ثواني التسجيل الصوتي"),
            ("window_geometry", "هندسة النافذة"),
        ]
        for i, (key, label) in enumerate(fields, start=1):
            tk.Label(parent, text=label, anchor="e", bg=T["bg"], fg=T["fg_dim"],
                     font=("Segoe UI", 9)).grid(row=i, column=0, sticky="ew", pady=(6, 0))
            e = tk.Entry(parent, font=("Segoe UI", 10), bg=T["entry_bg"], fg=T["fg"],
                         insertbackground=T["fg"])
            e.insert(0, str(self.settings.get(key, "")))
            e.grid(row=i + 1, column=0, sticky="ew")
            self._set_entrys[key] = e
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=12, column=0, sticky="ew", pady=8)
        tk.Button(bar, text="حفظ (كتابة ذرية fsync)", command=self.settings_save,
                  bg=T["accent"], fg="#06281F", font=("Segoe UI", 9, "bold")).pack(side="left")
        self.settings_lbl = tk.Label(bar, text="", bg=T["bg"], fg=T["ok"], font=("Segoe UI", 9))
        self.settings_lbl.pack(side="left", padx=10)
        self._settings_path_lbl = tk.Label(parent, text=f"المسار الحقيقي: {Path(self.lm.NEXUS_ROOT) / 'ui_settings.json'}",
                                           anchor="e", bg=T["bg"], fg=T["fg_dim"], font=("Segoe UI", 8))
        self._settings_path_lbl.grid(row=13, column=0, sticky="ew")

    def _settings_path(self) -> Path:
        return Path(self.lm.NEXUS_ROOT) / "ui_settings.json"

    def settings_load(self) -> dict:
        defaults = {"ollama_model": "qwen3:0.6b",
                    "model_base": "http://127.0.0.1:8080",
                    "workspace_root": "M:/NEXUS-Test",
                    "voice_seconds": "5",
                    "window_geometry": "1180x720+30+30"}
        try:
            p = self._settings_path()
            if p.is_file():
                loaded = json.loads(p.read_text(encoding="utf-8"))
                defaults.update({k: loaded[k] for k in defaults if k in loaded})
                self.activity("[settings] حُمّلت من القرص")
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[settings-err] {type(exc).__name__}: {exc}"[:160])
        return defaults

    def settings_save(self) -> dict:
        values = {k: e.get().strip() for k, e in self._set_entrys.items()}
        p = self._settings_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".tmp")
        tmp.write_text(json.dumps(values, ensure_ascii=False, indent=1), encoding="utf-8")
        with open(tmp, "rb") as fh:
            os.fsync(fh.fileno())
        os.replace(tmp, p)
        self.settings.update(values)
        self.settings_lbl.config(text=f"حُفظت ✅ {p.stat().st_size} B")
        self.activity(f"[settings] حفظ ذري — {p.stat().st_size} بايت على القرص")
        return values

    # ================================================== 26.10 Voice

    def _sec_voice(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(2, weight=1)
        tk.Label(parent, text="الصوت — Voice (26.10) — التقاط winmm حقيقي + WAV عبر nexus.speech",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=1, column=0, sticky="ew", pady=4)
        tk.Button(bar, text=f"سجّل ({self.settings.get('voice_seconds', '5')} ثانية — ميكروفون حقيقي)",
                  command=self.voice_record, bg=T["accent2"], fg="#3B2200",
                  font=("Segoe UI", 9, "bold")).pack(side="left", padx=2)
        tk.Button(bar, text="أنشئ موجة اختبار", command=self.voice_tone_btn,
                  ).pack(side="left", padx=2)
        tk.Button(bar, text="شغّل آخر ملف", command=self.voice_play_last
                  ).pack(side="left", padx=2)
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=8, state="disabled", wrap="word",
                                       font=("Consolas", 9), bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=2, column=0, sticky="nsew", pady=4)
        self.voice_widget = lb
        self.voice_status = tk.Label(parent, text="", anchor="e", bg=T["bg"],
                                     fg=T["fg_dim"], font=("Segoe UI", 8), wraplength=820,
                                     justify="right")
        self.voice_status.grid(row=3, column=0, sticky="ew")
        self._voice_fill()
        self._voice_providers()

    def _voice_dir(self) -> Path:
        return Path(self.lm.NEXUS_ROOT) / "voice"

    def _voice_providers(self) -> None:
        provs: list[str] = []
        err = ""
        try:
            from nexus.speech import PROVIDER_NAMES, available_providers
            provs = list(available_providers())
            allp = list(PROVIDER_NAMES)
            self.voice_status.config(
                text=f"مزودات ASR في النواة: {allp} — المتاحة محلياً الآن: {provs or 'لا شيء (صادق)'} · "
                     f"التحويل للنص سيُشغّل تلقائياً عند تثبيت مزود محلي")
        except BaseException as exc:  # noqa: BLE001
            err = f"{type(exc).__name__}: {exc}"[:120]
            self.voice_status.config(text=f"providers probe: {err}")
        self.data["voice_providers"] = {"available": provs, "error": err}

    def voice_tone_wav(self) -> dict:
        """REAL WAV through the core's speech.wavio (440Hz tone, 1.2s)."""
        out: dict = {}
        try:
            from nexus.speech import rms, write_wav
            rate = 16000
            n = int(rate * 1.2)
            samples = [0.35 * math.sin(2 * math.pi * 440.0 * k / rate) for k in range(n)]
            p = self._voice_dir() / f"tone_{time.strftime('%Y%m%d_%H%M%S')}.wav"
            write_wav(p, samples, rate)
            out = {"ok": True, "path": str(p), "size_bytes": p.stat().st_size,
                   "rms": round(float(rms(samples)), 4)}
            self.activity(f"[voice] موجة اختبار حقيقية عبر nexus.speech — {out['size_bytes']} B")
            self._voice_fill()
        except BaseException as exc:  # noqa: BLE001
            out = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:200]}
            self.activity(f"[voice-err] {out['error']}")
        self.data["last_tone"] = out
        return out

    def voice_tone_btn(self) -> None:
        self.voice_tone_wav()

    def voice_record(self) -> None:
        self.activity("[voice] بدء تسجيل من الميكروفون (winmm)…")
        rec = MicRecorder(seconds=float(self.settings.get("voice_seconds", "5") or 5)).record()
        if not rec.get("ok"):
            self.voice_status.config(text=f"التسجيل: فشل صادق — {rec.get('error', '')}")
            self.activity(f"[voice-err] {rec.get('error', '')}"[:160])
            return
        p = self._voice_dir() / f"mic_{time.strftime('%Y%m%d_%H%M%S')}.wav"
        saved = MicRecorder.save_wav(p, rec["pcm"], rec["rate"])
        if saved.get("ok"):
            self.voice_status.config(text=f"سُجّل {rec['seconds']}s → {p.name} ({saved['size_bytes']} B) — محفوظ على القرص")
            self.activity(f"[voice] تسجيل حقيقي: {p.name} · {saved['size_bytes']} B")
            self._voice_fill()
        else:
            self.voice_status.config(text=f"حفظ WAV: فشل صادق — {saved.get('error', '')}")

    def voice_play_last(self) -> None:
        try:
            import winsound
            files = sorted(self._voice_dir().glob("*.wav"))
            if not files:
                self.activity("[voice] لا ملفات للتشغيل — صادق")
                return
            winsound.PlaySound(str(files[-1]), winsound.SND_FILENAME)
            self.activity(f"[voice] تشغيل حقيقي: {files[-1].name}")
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[voice-play-err] {type(exc).__name__}: {exc}"[:160])

    def _voice_fill(self) -> None:
        w = getattr(self, "voice_widget", None)
        if w is None:
            return
        w.configure(state="normal")
        w.delete("1.0", "end")
        n = 0
        try:
            for f in sorted(self._voice_dir().glob("*.wav"), reverse=True):
                n += 1
                w.insert("end", f"• {f.name}  ·  {f.stat().st_size} B\n")
        except OSError as exc:
            w.insert("end", f"(غير متاح: {type(exc).__name__})\n")
        if n == 0:
            w.insert("end", "(لا تسجيلات بعد — بصدق)\n")
        w.configure(state="disabled")
        self.data["voice_files"] = n

    # ================================================== 26.11 Attachments

    def _sec_attachments(self, parent) -> None:
        tk = self.tk
        T = THEME
        parent.grid_columnconfigure(0, weight=1)
        parent.grid_rowconfigure(1, weight=1)
        tk.Label(parent, text="المرفقات — Attachments (26.11) — نسخ حقيقي + sha256 + شريحة في المحادثة",
                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        from tkinter import scrolledtext
        lb = scrolledtext.ScrolledText(parent, height=9, state="disabled", wrap="word",
                                       font=("Consolas", 9), bg=T["entry_bg"], fg=T["fg"])
        lb.grid(row=1, column=0, sticky="nsew", pady=4)
        self.attach_widget = lb
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=2, column=0, sticky="ew")
        tk.Button(bar, text="أرفق ملفاً (حوار حقيقي)", command=self.attachment_pick,
                  bg=T["accent"], fg="#06281F", font=("Segoe UI", 9, "bold")
                  ).pack(side="left", padx=2)
        self._attach_fill()

    def _attach_dir(self) -> Path:
        return Path(self.lm.NEXUS_ROOT) / "attachments" / "general"

    def attachment_add_path(self, src: Path) -> dict:
        """REAL copy + sha256 + chip. Returns the record honestly."""
        out: dict = {}
        try:
            src = Path(src)
            if not src.is_file():
                return {"ok": False, "error": f"الملف غير موجود: {src}"}
            dst_dir = self._attach_dir()
            dst_dir.mkdir(parents=True, exist_ok=True)
            dst = dst_dir / f"{time.strftime('%Y%m%d_%H%M%S')}_{src.name}"
            shutil.copy2(src, dst)
            rec = {"name": src.name, "path": str(dst),
                   "size_bytes": dst.stat().st_size, "sha256": _sha256_file(dst)}
            self.attachments.append(rec)
            chip = tk.Label(self.chips_frame, text=f"📎 {src.name} ({rec['size_bytes']} B)",
                            bg=THEME["panel"], fg=THEME["accent"], cursor="hand2",
                            font=("Segoe UI", 8))
            chip.pack(side="left", padx=3, pady=2)
            self.activity(f"[attach] نُسخ: {src.name} → sha256 {rec['sha256'][:16]}…")
            self._attach_fill()
            out = {"ok": True, **rec}
        except BaseException as exc:  # noqa: BLE001
            out = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:200]}
        self.data["last_attach"] = out
        return out

    def attachment_pick(self) -> None:
        try:
            from tkinter import filedialog
            p = filedialog.askopenfilename(title="أرفق ملفاً")
            if p:
                self.attachment_add_path(Path(p))
        except BaseException as exc:  # noqa: BLE001
            self.activity(f"[attach-err] {type(exc).__name__}: {exc}"[:160])

    def _attach_fill(self) -> None:
        w = getattr(self, "attach_widget", None)
        if w is None:
            return
        w.configure(state="normal")
        w.delete("1.0", "end")
        n = 0
        try:
            for f in sorted(self._attach_dir().glob("*"), reverse=True):
                if f.is_file():
                    n += 1
                    w.insert("end", f"• {f.name}  ·  {f.stat().st_size} B  ·  sha256 {_sha256_file(f)[:20]}…\n")
        except OSError as exc:
            w.insert("end", f"(غير متاح: {type(exc).__name__})\n")
        if n == 0:
            w.insert("end", "(لا مرفقات بعد — بصدق)\n")
        w.configure(state="disabled")
        self.data["attach_files"] = n

    # -------------------------------------------------------------- nav

    def show(self, sid: str) -> None:
        for s, btn in self.nav_btns.items():
            btn.configure(bg=THEME["nav_active"] if s == sid else THEME["panel2"],
                          fg=THEME["accent"] if s == sid else THEME["fg"])
        for s, f in self.frames.items():
            if s == sid:
                f.grid(row=0, column=0, sticky="nsew")
            else:
                f.grid_forget()
        self.container.grid_rowconfigure(0, weight=1)
        self.container.grid_columnconfigure(0, weight=1)
        self.current = sid
        self.current_title = dict(SECTIONS).get(sid, sid)
        self.lbl_section.config(text=f"{dict(SECTIONS)[sid]} — 26.{[s for s, _ in SECTIONS].index(sid) + 1}")
        self._set_status()


# ------------------------------------------------------------ the selftest


def ui_selftest(lm) -> int:
    """PHASE 26 selftest — all 11 sections, each functionally checked with a
    real screenshot as visual proof. Honest FAIL on any section."""
    import tkinter as tk

    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "phase26-desktop-ui-production",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(), "python": sys.version.split()[0],
                  "toolkit": "tkinter (stdlib)", "sections": {}}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p1 = _write_cert(Path(lm.PROOFS), "phase26_ui.json", cert)
        legacy = {k: cert.get(k) for k in ("verdict", "title", "tasks_count",
                                           "model", "screenshot", "cap_seed_check",
                                           "caps_cards", "cap_clicks", "core_ok",
                                           "sections_ok", "runtime_ok")}
        legacy.update({"product": lm.PRODUCT, "version": lm.VERSION,
                       "check": "gate6-desktop-ui", "pid": cert.get("pid"),
                       "python": cert.get("python"), "toolkit": cert.get("toolkit"),
                       "utc": cert.get("utc"), "phase26": True})
        _write_cert(Path(lm.PROOFS), "midpoint_ui.json", legacy)
        print(f"certificate: {p1}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "sections_ok", "runtime_ok", "model",
                           "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    try:
        root = tk.Tk()
    except BaseException as exc:  # noqa: BLE001
        return _finish("FAIL", error=f"tk.Tk: {type(exc).__name__}: {exc}"[:260])

    app = NEXUS26App(root, lm, selftest=True)
    cert["runtime_ok"] = app.runtime is not None
    cert["boot_error"] = app.boot_error
    cert["core_ok"] = app.core_ok
    cert["tasks_count"] = len(app.tasks_summaries)
    cert["title"] = root.title()

    frames_boot = _pump(root, 30)

    # ---------- functional checks per section (all real, all satisfiable)
    secs = cert["sections"]

    # 26.2 conversations — create a REAL conversation through SessionManager
    try:
        conv = app.conversation_create()
        secs["conversations"] = {
            "ok": conv is not None,
            "conv_id": str(getattr(conv, "id", ""))[:32],
            "live_count": len(app.conversations)}
    except BaseException as exc:  # noqa: BLE001
        secs["conversations"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.7 memory — real roundtrip + real core probe
    try:
        marker = f"phase26-check-{time.strftime('%H%M%S')}"
        app.memory_remember(marker)
        hits = app.memory_search("phase26-check")
        secs["memory"] = {"ok": len(hits) >= 1, "hits": len(hits),
                          "core": app.data.get("memory_core", {}),
                          "file_bytes": app._memory_path().stat().st_size}
    except BaseException as exc:  # noqa: BLE001
        secs["memory"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.8 checkpoints — real snapshot with manifest
    try:
        man = app.checkpoint_create()
        cp_dir = app._checkpoint_dir()
        manifest_exists = any((d / "manifest.json").is_file()
                              for d in cp_dir.glob("ui_cp_*"))
        secs["checkpoints"] = {"ok": bool(man.get("count", 0) >= 1 and manifest_exists),
                               "files": man.get("count", 0), "dir": str(cp_dir),
                               "listed": app.data.get("checkpoints_count", 0)}
    except BaseException as exc:  # noqa: BLE001
        secs["checkpoints"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.9 settings — atomic save → reload equal
    try:
        saved = app.settings_save()
        reloaded = app.settings_load()
        same = all(str(reloaded.get(k)) == str(v) for k, v in saved.items())
        secs["settings"] = {"ok": bool(same), "fields": len(saved),
                            "file_bytes": app._settings_path().stat().st_size}
    except BaseException as exc:  # noqa: BLE001
        secs["settings"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.10 voice — real WAV via nexus.speech (no mic dependency in selftest)
    try:
        tone = app.voice_tone_wav()
        secs["voice"] = {"ok": bool(tone.get("ok")) and (tone.get("size_bytes") or 0) > 400,
                         "tone": tone, "providers": app.data.get("voice_providers", {}),
                         "files": app.data.get("voice_files", 0)}
    except BaseException as exc:  # noqa: BLE001
        secs["voice"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.11 attachments — real copy + sha256 roundtrip (no dialog)
    try:
        tmp_src = Path(lm.NEXUS_ROOT) / "attachments" / "_selftest_src.txt"
        tmp_src.parent.mkdir(parents=True, exist_ok=True)
        tmp_src.write_text(f"PHASE 26 attachment selftest — {cert['utc']}\n", encoding="utf-8")
        att = app.attachment_add_path(tmp_src)
        want = _sha256_file(tmp_src)
        secs["attachments"] = {"ok": bool(att.get("ok")) and att.get("sha256") == want,
                               "sha256": str(att.get("sha256", ""))[:20],
                               "files": app.data.get("attach_files", 0)}
    except BaseException as exc:  # noqa: BLE001
        secs["attachments"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.1 chat — greeting rendered + real card seed (MIDPOINT-10 preserved)
    try:
        app.cap_seed("Coding", CAP_SEEDS["Coding"])
        seed_ok = app.entry.get() == CAP_SEEDS["Coding"]
        transcript = app.chat_widget.get("1.0", "end")
        secs["chat"] = {"ok": bool(seed_ok and transcript.count("nexus>") >= 1
                                   and transcript.count("أنت>") >= 1),
                        "cap_seed_check": "ok" if seed_ok else "mismatch",
                        "transcript_lines": len(transcript.splitlines())}
    except BaseException as exc:  # noqa: BLE001
        secs["chat"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.3 tasks — real repository listing
    secs["tasks"] = {"ok": len(app.tasks_summaries) >= 1,
                     "count": len(app.tasks_summaries)}

    # 26.4 activity — real accumulated lines + widget present
    try:
        app.show("activity")
        _pump(root, 8)
        text = app.act_widget.get("1.0", "end")
        secs["activity"] = {"ok": len(text.splitlines()) >= 4 and app._activity_n >= 4,
                            "lines": app._activity_n}
    except BaseException as exc:  # noqa: BLE001
        secs["activity"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.5 models — real probes (up or down — both honest, both recorded)
    try:
        app.show("models")
        _pump(root, 8)
        status_txt = app.models_status.cget("text")
        secs["models"] = {"ok": bool(status_txt) and "فحص" not in status_txt,
                          "status": status_txt[:80],
                          "ollama_models": app.data.get("ollama_models", [])[:5]}
    except BaseException as exc:  # noqa: BLE001
        secs["models"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    # 26.6 workspace — real disk entries
    try:
        app.show("workspace")
        _pump(root, 8)
        secs["workspace"] = {"ok": app.data.get("workspace_entries", 0) >= 1,
                             "entries": app.data.get("workspace_entries", 0)}
    except BaseException as exc:  # noqa: BLE001
        secs["workspace"] = {"ok": False, "error": f"{type(exc).__name__}: {exc}"[:160]}

    cert["cap_clicks"] = app.cap_clicks["n"]
    cert["caps_cards"] = len(CAPS)
    cert["cap_seed_check"] = secs.get("chat", {}).get("cap_seed_check", "missing")
    cert["pump_frames"] = frames_boot

    # ---------- per-section screenshots (the visual proofs)
    proofs = Path(lm.PROOFS)
    shots_all_ok = True
    shot_summary = {}
    for i, (sid, _t) in enumerate(SECTIONS, start=1):
        app.show(sid)
        f = _pump(root, 12)
        shot = grab_screen_png(proofs / "phase26" / f"sec_{i:02d}_{sid}.png")
        shot_summary[sid] = {"frames": f, "png": {k: shot.get(k) for k in
                                                  ("ok", "size_bytes", "width", "height")}}
        if not (shot.get("ok") and (shot.get("size_bytes") or 0) > 8000 and f >= 8):
            shots_all_ok = False
    cert["screenshots"] = shot_summary

    # gate-compat full-desktop proof (chat section on screen)
    app.show("chat")
    _pump(root, 12)
    shot = grab_screen_png(proofs / "midpoint_ui.png")
    cert["screenshot"] = shot

    cert["model"] = app.data.get("model_status", "…")

    sections_ok = all(s.get("ok") for s in secs.values()) and len(secs) == 11
    cert["sections_ok"] = sections_ok
    ok = (sections_ok and shots_all_ok and shot.get("ok")
          and (shot.get("size_bytes") or 0) > 8000
          and frames_boot >= 20 and app.core_ok >= 30
          and len(app.tasks_summaries) >= 1 and app.runtime is not None
          and len(CAPS) == 7 and cert["cap_seed_check"] == "ok")
    try:
        root.destroy()
    except BaseException:  # noqa: BLE001
        pass
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "one or more sections/screenshots failed — see phase26_ui.json")


# ---------------------------------------------------------- gate #7 tray


class _NOTIFYICONDATAW(ctypes.Structure):
    _fields_ = [
        ("cbSize", wintypes.DWORD), ("hWnd", wintypes.HWND),
        ("uID", ctypes.c_uint), ("uFlags", ctypes.c_uint),
        ("uCallbackMessage", ctypes.c_uint), ("hIcon", wintypes.HICON),
        ("szTip", ctypes.c_wchar * 128), ("dwState", wintypes.DWORD),
        ("dwStateMask", wintypes.DWORD), ("szInfo", ctypes.c_wchar * 256),
        ("uVersion", ctypes.c_uint), ("szInfoTitle", ctypes.c_wchar * 64),
        ("dwInfoFlags", wintypes.DWORD),
    ]


WNDPROC = ctypes.WINFUNCTYPE(ctypes.c_longlong, wintypes.HWND, ctypes.c_uint,
                             ctypes.c_longlong, ctypes.c_longlong)


class _WNDCLASSW(ctypes.Structure):
    _fields_ = [
        ("style", ctypes.c_uint), ("lpfnWndProc", WNDPROC),
        ("cbClsExtra", ctypes.c_int), ("cbWndExtra", ctypes.c_int),
        ("hInstance", wintypes.HINSTANCE), ("hIcon", wintypes.HICON),
        ("hCursor", ctypes.c_void_p), ("hbrBackground", wintypes.HBRUSH),
        ("lpszMenuName", wintypes.LPCWSTR), ("lpszClassName", wintypes.LPCWSTR),
    ]


def tray_selftest(lm) -> int:
    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "gate7-tray",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(),
                  "api": "Shell_NotifyIconW (ctypes, stdlib)"}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p = _write_cert(Path(lm.PROOFS), "midpoint_tray.json", cert)
        print(f"certificate: {p}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "add_ok", "modify_ok", "delete_ok",
                           "menu_items", "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    proc = WNDPROC(user32.DefWindowProcW)          # GC-anchor
    wc = _WNDCLASSW()
    wc.lpfnWndProc = proc
    wc.lpszClassName = "NEXUSTraySelftest"
    wc.hInstance = ctypes.windll.kernel32.GetModuleHandleW(None)
    if not user32.RegisterClassW(ctypes.byref(wc)):
        return _finish("FAIL", error=f"RegisterClassW: {ctypes.GetLastError()}")
    hwnd = user32.CreateWindowExW(0, wc.lpszClassName, "NEXUS tray host",
                                  0, 0, 0, 0, 0, None, None, wc.hInstance, None)
    if not hwnd:
        return _finish("FAIL", error=f"CreateWindowExW: {ctypes.GetLastError()}")

    hicon = shell32.ExtractIconW(0, sys.executable, 0)
    if not hicon:
        hicon = shell32.ExtractIconW(0, "imageres.dll", 0)
    cert["icon_source"] = "sys.executable" if hicon else "imageres.dll"

    nid = _NOTIFYICONDATAW()
    nid.cbSize = ctypes.sizeof(_NOTIFYICONDATAW)
    nid.hWnd = hwnd
    nid.uID = 1
    nid.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP
    nid.uCallbackMessage = WM_APP_TRAY
    nid.hIcon = hicon
    nid.szTip = "NEXUS — Ready"
    add_ok = bool(shell32.Shell_NotifyIconW(NIM_ADD, ctypes.byref(nid)))
    cert["add_ok"] = add_ok

    nid.szTip = "NEXUS — Working"
    mod_ok = bool(shell32.Shell_NotifyIconW(NIM_MODIFY, ctypes.byref(nid)))
    cert["modify_ok"] = mod_ok
    cert["states_shown"] = ["Ready", "Working"]

    # a REAL popup menu (built; display interaction belongs to a live run)
    hmenu = user32.CreatePopupMenu()
    items = ["فتح NEXUS", "إيقاف مؤقت", "استئناف", "خروج"]
    appended = []
    for i, label in enumerate(items, start=1):
        if user32.AppendMenuW(hmenu, MF_STRING, i, label):
            appended.append(label)
    cert["menu_items"] = appended

    # a real message pump — 3 seconds of PeekMessage/Dispatch
    msg = wintypes.MSG()
    end = time.time() + 3.0
    pumped = 0
    while time.time() < end:
        if user32.PeekMessageW(ctypes.byref(msg), None, 0, 0, PM_REMOVE):
            user32.TranslateMessage(ctypes.byref(msg))
            user32.DispatchMessageW(ctypes.byref(msg))
        else:
            pumped += 1
            time.sleep(0.05)
    cert["pump_iterations"] = pumped

    shot = grab_screen_png(Path(lm.PROOFS) / "midpoint_tray.png")
    cert["screenshot"] = shot
    cert["screenshot_note"] = ("full desktop — the tray icon may sit in the "
                               "overflow flyout (Win11); the API verdicts "
                               "here are the binding evidence")

    del_ok = bool(shell32.Shell_NotifyIconW(NIM_DELETE, ctypes.byref(nid)))
    cert["delete_ok"] = del_ok
    user32.DestroyMenu(hmenu)
    user32.DestroyWindow(hwnd)
    user32.UnregisterClassW(wc.lpszClassName, wc.hInstance)

    ok = add_ok and mod_ok and del_ok and len(appended) == 4 and shot.get("ok")
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "one of the tray API verdicts failed")


# -------------------------------------------------------- gate #8 overlay


def overlay_selftest(lm) -> int:
    import tkinter as tk

    t0 = time.time()
    cert: dict = {"product": lm.PRODUCT, "version": lm.VERSION,
                  "check": "gate8-overlay",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "pid": os.getpid(),
                  "toolkit": "tkinter Toplevel topmost+alpha (stdlib)"}

    def _finish(verdict: str, **extra) -> int:
        cert["verdict"] = verdict
        cert["seconds"] = round(time.time() - t0, 2)
        cert.update(extra)
        p = _write_cert(Path(lm.PROOFS), "midpoint_overlay.json", cert)
        print(f"certificate: {p}")
        print(json.dumps({k: cert.get(k) for k in
                          ("verdict", "topmost", "alpha", "pause_worked",
                           "screenshot")}, ensure_ascii=False))
        return 0 if verdict == "PASS" else 1

    try:
        root = tk.Tk()
        root.withdraw()
    except BaseException as exc:  # noqa: BLE001
        return _finish("FAIL", error=f"tk.Tk: {type(exc).__name__}: {exc}"[:260])

    ov = tk.Toplevel()
    ov.title("NEXUS overlay")
    ov.overrideredirect(True)
    ov.attributes("-topmost", True)
    try:
        ov.attributes("-alpha", 0.88)
    except BaseException:  # noqa: BLE001
        pass
    sw = ov.winfo_screenwidth()
    sh = ov.winfo_screenheight()
    w, h = 380, 96
    ov.geometry(f"{w}x{h}+{sw - w - 24}+{sh - h - 90}")
    ov.configure(bg="#101418")

    state = {"paused": False}
    label = tk.Label(ov, text="NEXUS is working — نكسس يعمل",
                     fg="#f5f5f4", bg="#101418", font=("Segoe UI", 12, "bold"))
    label.pack(pady=(10, 4))
    btns = tk.Frame(ov, bg="#101418")
    btns.pack()

    def _toggle(_=None) -> None:
        state["paused"] = not state["paused"]
        label.config(text=("NEXUS paused — نكسس متوقف مؤقتاً" if state["paused"]
                           else "NEXUS is working — نكسس يعمل"))

    pause_btn = tk.Button(btns, text="Pause", command=_toggle, width=9)
    pause_btn.pack(side="left", padx=6, pady=6)
    resume_btn = tk.Button(btns, text="Resume", command=_toggle, width=9)
    resume_btn.pack(side="left", padx=6, pady=6)

    cert["topmost"] = bool(int(ov.attributes("-topmost")))
    try:
        cert["alpha"] = round(float(ov.attributes("-alpha")), 2)
    except BaseException:  # noqa: BLE001
        cert["alpha"] = None

    f1 = _pump(ov, 25)
    pause_btn.invoke()               # REAL button press — state flips
    cert["pause_worked"] = state["paused"]
    label_text_after = label.cget("text")
    f2 = _pump(ov, 25)
    resume_btn.invoke()
    cert["resume_worked"] = not state["paused"]
    f3 = _pump(ov, 25)
    cert["pump_frames"] = [f1, f2, f3]
    cert["label_after_pause"] = label_text_after

    shot = grab_screen_png(Path(lm.PROOFS) / "midpoint_overlay.png")
    cert["screenshot"] = shot

    try:
        ov.destroy()
        root.destroy()
    except BaseException:  # noqa: BLE001
        pass
    ok = (cert.get("topmost") and cert.get("pause_worked")
          and cert.get("resume_worked") and shot.get("ok")
          and (shot.get("size_bytes") or 0) > 8000 and f3 >= 20)
    return _finish("PASS" if ok else "FAIL",
                   error=None if ok else "overlay checks incomplete")
