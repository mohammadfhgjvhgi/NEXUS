                                     insertbackground=T["fg"])
        self.memory_entry.grid(row=0, column=0, sticky="ew", padx=(0, 6))
        self.memory_entry.insert(0, "تذكّر: مفاتيح مشروعي في M:\\NEXUS\\docs")
        tk.Button(bar, text="تذكّر", command=self.memory_remember_btn, width=8
                  ).grid(row=0, column=1, padx=2)
