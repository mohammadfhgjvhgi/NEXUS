                 anchor="e", bg=T["bg"], fg=T["fg"], font=("Segoe UI", 10, "bold")
                 ).grid(row=0, column=0, sticky="ew")
        self.memory_core_lbl = tk.Label(parent, text="…", anchor="e", bg=T["bg"],
                                        fg=T["fg_dim"], font=("Segoe UI", 8))
        self.memory_core_lbl.grid(row=1, column=0, sticky="ew")
        bar = tk.Frame(parent, bg=T["bg"])
        bar.grid(row=2, column=0, sticky="ew", pady=(4, 2))
